# ==============================================================================
# DAYFLOW HRMS 2.0 - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust values for your deployment environment
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# JSON Web Token (JWT) Security Secret
# Generate a cryptographically secure 256-bit string in production:
# e.g., openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_secret_in_production

# Frontend Client Origin (for CORS restriction in strict environments)
CLIENT_URL=http://localhost:5173

# Storage Paths (Optional: defaults to server/data and server/uploads)
DATABASE_PATH=./server/data/dayflow_db.json
UPLOADS_PATH=./server/uploads
